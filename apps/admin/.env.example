# Server-only. NEVER prefix these with NEXT_PUBLIC_ — that would inline them
# into the browser bundle. Set the real values in Vercel's project settings
# (Volume 8), never in a committed file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fail-closed gate for the whole panel. With these unset every route returns
# 503, so a deployed admin panel is never anonymously readable.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
