# Server-only. NEVER prefix these with NEXT_PUBLIC_ — that would inline them
# into the browser bundle. Set the real values in Vercel's project settings
# (Volume 8), never in a committed file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# W4-06 admin authentication. With ADMIN_SESSION_SECRET or ADMIN_ROLES unset or
# malformed, every route returns 503, so a deployed panel is never anonymously
# readable. Basic Auth (ADMIN_BASIC_AUTH_USER/PASSWORD) is RETIRED and is no
# longer read by anything.

# HMAC key for the session cookie. At least 32 bytes. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Bump this integer to invalidate every live session at once. Optional; unset
# means 0. All-or-nothing until the Batch 3 session table.
ADMIN_SESSION_EPOCH=

# Salts and hashes ONLY — never a plaintext password; a password field here is a
# parse error. Read in the Node login route, never in the Edge middleware.
# Generate each element with:
#   node scripts/admin-hash-password.mjs <username>      (password on stdin)
# ADMIN_ACCOUNTS=[{"username":"founder","salt":"<32 hex>","hash":"<64 hex>"}]
ADMIN_ACCOUNTS=

# username -> role, and AUTHORITATIVE: it is re-read on every request, so
# removing a username here denies that account's next request even though its
# cookie is still valid. Roles: super_admin | billing | support | read_only.
# Every ADMIN_ACCOUNTS username must appear here and vice versa.
# ADMIN_ROLES={"founder":"super_admin"}
ADMIN_ROLES=

# Optional. The exact origin the login form may be posted from, e.g.
# https://admin.muthoy.app. Unset means the request's own origin (including the
# x-forwarded-host one behind a proxy) is used.
ADMIN_ORIGIN=
