# Sanitized public configuration only. Never add server/signing/provider secrets.
# Explicitly set APP_VARIANT in the shell BEFORE invoking pnpm/EAS.
# development -> .dev / DEV; preview -> .preview / DEV; production -> verified PROD.
# Production policy is intentionally unset and production validation refuses.
# PowerShell: $env:APP_VARIANT='development'; pnpm --filter @muthoy/mobile start
# Run env:check before local actions; hosted profiles use env:check:eas -- --profile.
# EXPO_PUBLIC values are inlined; restart Metro after changing public values.
# ANON_KEY accepts an approved legacy anon or publishable public key.
# EAS builds must use selected project-scoped public variables, never local .env.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
