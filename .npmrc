auto-install-peers=true
strict-peer-dependencies=false
virtual-store-dir-max-length=24

# virtual-store-dir must NOT be pinned here. An absolute Windows path (e.g.
# D:/mv4) is not a valid path on Linux/macOS — pnpm was creating a bogus
# store under a literal "D:" folder on GitHub Actions (Linux), which broke
# module resolution for eslint-config-next's own plugin deps
# (eslint-plugin-react-hooks etc.) in apps/admin.
# Windows devs hitting ENAMETOOLONG: set it in pnpm's per-machine global
# config instead, never in this committed file:
#   pnpm config set virtual-store-dir D:/mv4 --global

# Fallback only: uncomment + `pnpm install` again if Metro can't resolve
# @muthoy/* workspace packages through pnpm's symlinked node_modules
# (apps/mobile/metro.config.js enables symlink support first; try that before this).
# node-linker=hoisted
