auto-install-peers=true
strict-peer-dependencies=false
virtual-store-dir=D:/mv4
virtual-store-dir-max-length=24

# Fallback only: uncomment + `pnpm install` again if Metro can't resolve
# @muthoy/* workspace packages through pnpm's symlinked node_modules
# (apps/mobile/metro.config.js enables symlink support first; try that before this).
# node-linker=hoisted
