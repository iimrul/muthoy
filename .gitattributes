# Line endings are pinned for every file whose SHA-256 is recorded as H-9 evidence.
# The A5 runtime verifies these by hash (PINNED_INPUTS, runtime-manifest.json,
# SOURCE_SUBSCRIBER_ALLOWLIST) and docs/plans/h9-* cite those values. Without an
# explicit eol, a clone whose local core.autocrlf is true checks them out as CRLF
# and every recorded hash stops reproducing. These files are already LF in the index,
# so this pins existing bytes rather than changing them.
scripts/h9/** text eol=lf
scripts/h9-f12-hosted-preflight.mjs text eol=lf
backend/supabase/checks/h9_hosted_preflight.sql text eol=lf
backend/supabase/checks/h9_postmigration_checks.sql text eol=lf
backend/supabase/functions/sync/_shared/phone.ts text eol=lf
backend/supabase/functions/sync/deviceLogin.ts text eol=lf
backend/supabase/migrations/20261015000000_h9_api_role_table_privileges.sql text eol=lf
backend/supabase/deploy/H9-LOCAL-REMEDIATION.md text eol=lf

# E4 (Batch 3, migration 35). Same rule and the same reason as the block above:
# these two files' SHA-256 values are recorded as E4 evidence in
# backend/supabase/migrations/e4-source-hashes.json, so a clone whose
# core.autocrlf is true must not check them out as CRLF. Adding them here is
# additive — no existing pin is changed.
#
# That path is NOT audit-artifacts/e4/, which is where this comment used to
# point and where the plan originally put the manifest. `.gitignore` ignores
# audit-artifacts/ wholesale, so a manifest there could never be committed and
# the directory does not exist; scripts/e4-evidence-manifest.mjs records the
# move and owns MANIFEST_PATH. The wrong path survived here because nothing
# reads a comment.
backend/supabase/migrations/20261023000000_e4_batch3_admin_platform.sql text eol=lf
backend/supabase/checks/e4_postmigration_checks.sql text eol=lf

# E4-B (migration 36) and its successor manifest. Same rule, and one difference
# that matters: `successorPinDrift` in
# backend/supabase/pgtest/live-chain-succession.pgtest.ts hashes the migration's
# RAW BYTES, not the CRLF-folded text the E4 manifest's `hashFile` uses. The E4
# manifest would survive a CRLF checkout; this pin would not. So for these two
# files the eol pin is load-bearing rather than belt-and-braces.
backend/supabase/migrations/20261030000000_e4b_publication_snapshots.sql text eol=lf
backend/supabase/migrations/20261031000000_e11_entitlement_verification.sql text eol=lf
backend/supabase/migrations/post-e4-source-hashes.json text eol=lf
